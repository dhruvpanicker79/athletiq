PORT=5050
NODE_ENV=development
# Real MongoDB (local or Atlas). If unreachable in development, the built-in local DB is used automatically. Set to "local" to always use it.
MONGO_URI=mongodb://127.0.0.1:27017/athletiq
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_NAME=Athletiq Admin
ADMIN_EMAIL=admin@athletiq.dev
ADMIN_PASSWORD=Admin@12345
